{
  "name": "raposafm",
  "version": "0.1.0",
  "private": true,
  "description": "Despachante de webhooks assíncrono, leve e self-hosted.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start:api": "node src/api/server.js",
    "start:worker": "node src/worker/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js --runInBand",
    "test:load": "node scripts/load/run.mjs ingest",
    "test:stress": "node scripts/load/run.mjs stress",
    "check:template-sync": "node scripts/check-template-sync.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/rabbitmq": "^12.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0"
  }
}
