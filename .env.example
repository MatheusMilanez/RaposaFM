# Copie este arquivo para .env e ajuste os valores.
# Nenhuma credencial real deve ser commitada — .env está no .gitignore.

# --- RabbitMQ ---
# Usados pelo docker-compose.yml para criar o usuário administrador do broker.
RABBITMQ_USER=raposafm
RABBITMQ_PASSWORD=changeme

# String de conexão usada pela API e pelo worker (precisa refletir as
# credenciais acima quando estiver rodando via Docker Compose).
RABBITMQ_URL=amqp://raposafm:changeme@localhost:5672

# --- PostgreSQL ---
# Usados pelo docker-compose.yml para criar o usuário e o banco.
POSTGRES_USER=raposafm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=raposafm

# String de conexão usada pelo runner de migrações (npm run migrate:up).
DATABASE_URL=postgres://raposafm:changeme@localhost:5432/raposafm

# --- API ---
API_PORT=3000

# Bloqueia por padrão webhook apontando pra localhost/IP privado/link-local
# (proteção contra SSRF — ver src/shared/ssrfGuard.js). Só ligar como "true"
# em desenvolvimento local, pra testar contra um destino na sua máquina.
# NUNCA ligar em produção.
ALLOW_PRIVATE_NETWORK_URLS=false

# --- Worker ---
WORKER_PREFETCH=10
MAX_RETRIES=5
HTTP_TIMEOUT_MS=5000

# Degraus do backoff exponencial em ms, separados por vírgula. A tentativa N
# usa o degrau min(N-1, ultimo); depois do último, repete o valor final até
# MAX_RETRIES estourar e a mensagem ir para a DLQ.
RETRY_BACKOFF_MS=60000,300000,900000

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
